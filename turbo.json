{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["NODE_ENV", "CI", "GODOT_BIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "STATIC_EXPORT",
        "NEXT_PUBLIC_PLAY_URL",
        "NEXT_PUBLIC_LOCAL_PLAY_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_COMMUNITY_URL",
        "NEXT_PUBLIC_SUPPORT_URL"
      ]
    },
    "build:static": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"],
      "env": [
        "STATIC_EXPORT",
        "NEXT_PUBLIC_PLAY_URL",
        "NEXT_PUBLIC_LOCAL_PLAY_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_COMMUNITY_URL",
        "NEXT_PUBLIC_SUPPORT_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "check": {
      "cache": false
    }
  }
}

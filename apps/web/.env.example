# Public itch.io page for Riposte. Empty until the itch instance is published.
# Non-local /play sends players here when set. https only. Never invent a URL.
NEXT_PUBLIC_PLAY_URL=

# Local Godot Web export. Defaults to the standalone serve at http://127.0.0.1:8060/
# NEXT_PUBLIC_LOCAL_PLAY_URL=http://127.0.0.1:8060/

# Purpose-named community destinations (shown as Discord and Patreon).
# Empty renders a "Coming soon" stub. https only. Never invent a URL.
NEXT_PUBLIC_COMMUNITY_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Set by `pnpm build:static`. Do not set in .env.local for `pnpm dev`.
# STATIC_EXPORT=

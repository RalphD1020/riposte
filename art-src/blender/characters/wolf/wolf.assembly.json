  "art": {
    "profile": "riposte_heroic_dark_fantasy",
    "notes": "The machine-readable part of Wolf's identity standard (docs/reference/blender-mcp-character-art-direction.md), read by the assembly (character_modeling.identity), the audits and Blender MCP tasks. Ranger and Training are two presentations of one character: base, configuration, face, WolfRig, skin, hair colour, scale, mass, clips and weapon attachment are shared by construction (one manifest).",
    "anchors": {
      "face": "the approved flat-panel head: two simple dark eyes, the split brow, the central ridge, the pointed nose; no realistic facial anatomy",
      "anatomy": "the accepted male base in its default (weightlifter) configuration: broad chest, substantial upper back, athletic arms, coherent pelvis-to-leg transition",
      "silhouette": "his hairstyle, his head profile and a practical swordsman's posture",
      "equipment": "the leather mantle, the sash, bracers and the hand-and-a-half sword"
    },

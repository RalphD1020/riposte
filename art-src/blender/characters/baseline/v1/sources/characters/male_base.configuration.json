    "character.male_base.lean": "lean",
    "character.male_base.lean_half": "lean_half",
    "character.male_base.heavy_half": "heavy_half",
    "character.male_base.heavy": "heavy",
    "character.male_base.extreme_lean": "extreme_lean",
    "character.male_base.extreme_heavy": "extreme_heavy"
  }
}

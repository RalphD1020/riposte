    { "id": "upper_body", "range": [-1, 1], "reads": "balanced <- -> broad and powerful" },
    { "id": "chest", "range": [-1, 1], "reads": "chest volume" },
    { "id": "shoulders", "range": [-1, 1], "reads": "shoulder mantle volume" },
    { "id": "waist", "range": [-1, 1], "reads": "waist volume" },
    { "id": "arms", "range": [-1, 1], "reads": "arm girth" },
    { "id": "legs", "range": [-1, 1], "reads": "leg girth" }
  ],
  "configurations": {

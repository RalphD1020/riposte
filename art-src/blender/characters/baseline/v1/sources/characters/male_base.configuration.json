    "lean_half": { "mass": -0.5, "definition": 0.25 },
    "heavy_half": { "mass": 0.5, "definition": 0.25 },
    "heavy": { "mass": 1, "definition": 0.5 },
    "extreme_lean": { "mass": -1, "definition": 1, "upper_body": -1, "chest": -1, "shoulders": -1, "waist": -1, "arms": -1, "legs": -1 },
    "extreme_heavy": { "mass": 1, "definition": -1, "upper_body": 1, "chest": 1, "shoulders": 1, "waist": 1, "arms": 1, "legs": 1 }
